[Unit]
Description=meetscribe - record, transcribe and take notes on browser meetings
After=pipewire-pulse.service pulseaudio.service

[Service]
ExecStart=%h/.local/bin/meetscribe watch
# AWS_REGION / AWS_PROFILE / API keys: one KEY=VALUE per line, chmod 600.
EnvironmentFile=-%h/.config/meetscribe/env
Restart=on-failure
RestartSec=10
# Stopping finishes the transcript and writes the final notes; give it time.
KillSignal=SIGTERM
TimeoutStopSec=300

[Install]
WantedBy=default.target
